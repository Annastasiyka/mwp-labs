API_PORT=8801
NODE_LOCAL_PORT=8081

# Налаштування MongoDB
DB_USER=movieuser
DB_PASSWORD=moviepass
DB_HOST=business-database
DB_PORT=27017
DB_NAME=business_db

# Повний рядок підключення для Mongoose
MONGO_URI=mongodb://movieuser:moviepass@business-database:27017/business_db?authSource=admin

# Безпека та брокер повідомлень RabbitMQ
JWT_SECRET_KEY=my_super_secret_jwt_key_12345
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=app-queue-message
RABBITMQ_AMQP_PORT=5672
RABBITMQ_URL=amqp://guest:guest@app-queue-message:5672