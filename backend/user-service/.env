APPLICATION_URL=https://web.com

# Налаштування бази даних MongoDB
DB_HOST=user-database
DB_PORT=27017
DB_NAME=user_db
DB_USER=dbuser
DB_PASSWORD=dbpwd

# Повний рядок підключення для Mongoose
MONGO_URI=mongodb://dbuser:dbpwd@user-database:27017/user_db?authSource=admin

# Змінні для Docker Compose
MONGODB_USER=dbuser
MONGODB_PASSWORD=dbpwd
MONGODB_LOCAL_PORT=27019
MONGODB_DOCKER_PORT=27017

# Налаштування портів сервісу
API_PORT=8800
NODE_LOCAL_PORT=8090

# Безпека та брокер повідомлень RabbitMQ
JWT_SECRET_KEY=my_super_secret_jwt_key_12345
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=app-queue-message
RABBITMQ_AMQP_PORT=5672
RABBITMQ_URL=amqp://guest:guest@app-queue-message:5672